{
  "name": "htmd-ts",
  "version": "0.1.0",
  "private": true,
  "description": "HTMD Markdown format SDK with synchronous ProseMirror JSON conversion",
  "type": "module",
  "packageManager": "bun@1.4.2",
  "engines": {
    "bun": ">=1.4.2"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "clean": "rm -rf dist coverage",
    "test": "bun test"
  },
  "devDependencies": {
    "@types/bun": "1.4.2",
    "prettier": "3.9.8",
    "typescript": "7.0.2"
  },
  "dependencies": {
    "@tiptap/core": "3.31.4",
    "@tiptap/extension-task-item": "3.31.4",
    "@tiptap/extension-task-list": "3.31.4",
    "@tiptap/markdown": "3.31.4",
    "@tiptap/pm": "3.31.4",
    "@tiptap/starter-kit": "3.31.4",
    "@xmldom/xmldom": "0.9.12",
    "marked": "17.0.6"
  }
}
