{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Hypertextual · Tauri",
  "version": "0.1.0",
  "identifier": "dev.hypertextual.poc",
  "build": {
    "beforeDevCommand": "npm --prefix web run dev",
    "beforeBuildCommand": "npm --prefix web run build",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../web/dist"
  },
  "app": {
    "windows": [{ "title": "Hypertextual · Tauri", "width": 1240, "height": 840, "minWidth": 760, "minHeight": 500 }],
    "security": { "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src ipc: http://ipc.localhost" }
  },
  "bundle": { "active": false, "icon": ["icons/128x128.png"] }
}
